<Window x:Class="WallpaperCycle.Views.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WallpaperCycle"
        Height="640"
        Width="560"
        MinHeight="520"
        MinWidth="460"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="-1"
                        CornerRadius="12"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <!-- Outer rounded surface -->
  <Border x:Name="RootBorder"
          Background="{StaticResource BgBrush}"
          BorderBrush="#FF383838"
          BorderThickness="1"
          CornerRadius="12"
          ClipToBounds="True">
    <DockPanel>

      <!-- ══════════ Custom title bar (drag region) ══════════ -->
      <Border x:Name="TitleBar"
              DockPanel.Dock="Top"
              Height="36"
              Background="{StaticResource BgBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- App mark + title — also part of drag area -->
          <StackPanel Orientation="Horizontal"
                      VerticalAlignment="Center"
                      Margin="14,0,0,0"
                      IsHitTestVisible="False">
            <Ellipse Width="10"
                     Height="10"
                     Fill="{StaticResource AccentBrush}"
                     Margin="0,0,8,0"/>
            <TextBlock Text="WallpaperCycle"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>

          <!-- Caption buttons — must be hit-testable in chrome -->
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal">
            <Button Style="{StaticResource CaptionButton}"
                    Content="–"
                    FontSize="16"
                    Click="Minimize_Click"
                    ToolTip="Minimize"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Style="{StaticResource CaptionCloseButton}"
                    Content="✕"
                    FontSize="12"
                    Click="Close_Click"
                    ToolTip="Close"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Thin accent line -->
      <Border DockPanel.Dock="Top"
              Height="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0"
                               EndPoint="1,0">
            <GradientStop Color="#0060CDFF"
                          Offset="0"/>
            <GradientStop Color="#FF60CDFF"
                          Offset="0.35"/>
            <GradientStop Color="#FF60CDFF"
                          Offset="0.65"/>
            <GradientStop Color="#0060CDFF"
                          Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <!-- ══════════ Main content ══════════ -->
      <DockPanel Margin="20,16,20,16">

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top"
                    Margin="0,0,0,16">
          <TextBlock Text="WallpaperCycle"
                     FontSize="24"
                     FontWeight="SemiBold"
                     Margin="0,0,0,4"/>
          <TextBlock x:Name="StatusText"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="12.5"
                     TextWrapping="Wrap"
                     Text="Starting…"/>
        </StackPanel>

        <!-- Footer -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
          <Button x:Name="ChangeNowButton"
                  Content="Change now"
                  Margin="0,0,8,0"
                  Click="ChangeNow_Click"/>
          <Button x:Name="SaveButton"
                  Content="Save settings"
                  Style="{StaticResource AccentButton}"
                  Click="Save_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>

            <!-- Wallpaper folder -->
            <Border Background="{StaticResource CardBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Wallpaper folder"
                           FontWeight="SemiBold"
                           FontSize="13.5"
                           Margin="0,0,0,10"/>

                <DockPanel Margin="0,0,0,10">
                  <Button DockPanel.Dock="Right"
                          Style="{StaticResource IconButton}"
                          Margin="8,0,0,0"
                          Click="Browse_Click"
                          ToolTip="Browse for folder">
                    <StackPanel Orientation="Horizontal">
                      <!-- Simple folder path icon (no special font) -->
                      <Viewbox Width="14"
                               Height="14"
                               Margin="0,0,7,0"
                               VerticalAlignment="Center">
                        <Canvas Width="16"
                                Height="16">
                          <Path Fill="{StaticResource TextBrush}"
                                Data="M 1,3 L 6,3 L 8,5 L 15,5 L 15,14 L 1,14 Z"/>
                        </Canvas>
                      </Viewbox>
                      <TextBlock Text="Browse"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <TextBox x:Name="FolderBox"
                           Style="{StaticResource PathBoxStyle}"/>
                </DockPanel>

                <DockPanel>
                  <Button x:Name="RefreshButton"
                          DockPanel.Dock="Right"
                          Style="{StaticResource IconButton}"
                          Padding="8,4"
                          Click="Refresh_Click"
                          ToolTip="Rescan folder">
                    <!-- Circular refresh arrow via path -->
                    <Viewbox Width="14"
                             Height="14">
                      <Canvas Width="16"
                              Height="16">
                        <Path Stroke="{StaticResource TextBrush}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 13,8 A 5,5 0 1 1 11,4"/>
                        <Path Fill="{StaticResource TextBrush}"
                              Data="M 11,1.5 L 14.5,4.5 L 10.5,5.5 Z"/>
                      </Canvas>
                    </Viewbox>
                  </Button>
                  <TextBlock x:Name="CountText"
                             Foreground="{StaticResource MutedBrush}"
                             FontSize="12.5"
                             VerticalAlignment="Center"
                             Text="0 image(s) found"/>
                </DockPanel>

                <!-- Empty state -->
                <Border x:Name="EmptyStatePanel"
                        Visibility="Collapsed"
                        Margin="0,14,0,0"
                        Padding="16"
                        Background="#18FFFFFF"
                        CornerRadius="8">
                  <StackPanel HorizontalAlignment="Center">
                    <Viewbox Width="56"
                             Height="56"
                             Margin="0,0,0,10">
                      <Canvas Width="64"
                              Height="64">
                        <Rectangle Width="48"
                                   Height="36"
                                   Canvas.Left="8"
                                   Canvas.Top="16"
                                   RadiusX="4"
                                   RadiusY="4"
                                   Stroke="#FF60CDFF"
                                   StrokeThickness="2"
                                   Fill="#1860CDFF"/>
                        <Ellipse Width="14"
                                 Height="14"
                                 Canvas.Left="14"
                                 Canvas.Top="22"
                                 Fill="#FF60CDFF"
                                 Opacity="0.5"/>
                        <Path Stroke="#FF60CDFF"
                              StrokeThickness="2"
                              Data="M 12,44 L 28,30 L 38,38 L 52,24"/>
                      </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="EmptyStateTitle"
                               Text="No images found"
                               FontWeight="SemiBold"
                               FontSize="13.5"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="EmptyStateMessage"
                               Text="Add JPG, PNG, or WebP files to this folder, or choose a different location."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="360"/>
                    <Button Content="Choose folder"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0"
                            Padding="16,7"
                            Click="Browse_Click"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- Current wallpaper + pin + selector -->
            <Border Background="{StaticResource CardBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <Button x:Name="PinButton"
                          DockPanel.Dock="Right"
                          Style="{StaticResource IconButton}"
                          Padding="12,5"
                          MinWidth="52"
                          HorizontalAlignment="Right"
                          Click="Pin_Click"
                          ToolTip="Pin this wallpaper (stops auto-rotation)">
                    <TextBlock x:Name="PinButtonLabel"
                               Text="Pin"
                               FontSize="12"/>
                  </Button>
                  <TextBlock Text="Current wallpaper"
                             FontWeight="SemiBold"
                             FontSize="13.5"
                             VerticalAlignment="Center"/>
                </DockPanel>

                <Grid>
                  <Border x:Name="PreviewFrame"
                          CornerRadius="8"
                          Background="#FF161616"
                          BorderBrush="#FF3A3A3A"
                          BorderThickness="1"
                          ClipToBounds="True"
                          Height="240">
                    <Grid>
                      <TextBlock x:Name="PreviewPlaceholder"
                                 Text="No wallpaper"
                                 Foreground="{StaticResource MutedBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontSize="12"/>
                      <!-- Old frame (under iris) -->
                      <Image x:Name="PreviewImageOld"
                             Stretch="Uniform"
                             Visibility="Collapsed"/>
                      <!-- New frame (clipped by expanding iris) -->
                      <Image x:Name="PreviewImage"
                             Stretch="Uniform"
                             Visibility="Collapsed"/>
                      <!-- Selector trigger (top-right) -->
                      <Button x:Name="SelectorButton"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="8"
                              Style="{StaticResource IconButton}"
                              Padding="8,6"
                              Background="#CC1C1C1C"
                              Click="Selector_Click"
                              ToolTip="Choose a wallpaper">
                        <TextBlock Text="☰"
                                   FontSize="14"/>
                      </Button>
                    </Grid>
                  </Border>
                </Grid>

                <TextBlock x:Name="CurrentNameText"
                           Text=""
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,8,0,0"/>

                <!-- Popup list -->
                <Popup x:Name="SelectorPopup"
                       PlacementTarget="{Binding ElementName=PreviewFrame}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                  <Border Background="#FF262626"
                          BorderBrush="#FF3A3A3A"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="6"
                          Width="{Binding ElementName=PreviewFrame, Path=ActualWidth}"
                          MaxHeight="280">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl x:Name="WallpaperList">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Click="WallpaperItem_Click"
                                    Tag="{Binding Path}"
                                    Background="Transparent"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="6"
                                    Margin="0,1">
                              <Button.Template>
                                <ControlTemplate TargetType="Button">
                                  <Border x:Name="bd"
                                          Background="{TemplateBinding Background}"
                                          CornerRadius="6"
                                          Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                  </Border>
                                  <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                      <Setter TargetName="bd"
                                              Property="Background"
                                              Value="#FF333333"/>
                                    </Trigger>
                                  </ControlTemplate.Triggers>
                                </ControlTemplate>
                              </Button.Template>
                              <DockPanel>
                                <Border DockPanel.Dock="Left"
                                        Width="56"
                                        Height="36"
                                        CornerRadius="4"
                                        Background="#FF161616"
                                        ClipToBounds="True"
                                        Margin="0,0,10,0">
                                  <Image Source="{Binding Thumbnail}"
                                         Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="12"/>
                              </DockPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </StackPanel>
            </Border>

            <!-- Change interval -->
            <Border Background="{StaticResource CardBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Change interval"
                           FontWeight="SemiBold"
                           FontSize="13.5"
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">
                  <ToggleButton x:Name="ChipTest"
                                Style="{StaticResource ChipStyle}"
                                Content="Testing · 1 min"
                                Margin="0,0,8,0"
                                Click="ChipTest_Click"/>
                  <ToggleButton x:Name="ChipDaily"
                                Style="{StaticResource ChipStyle}"
                                Content="Daily · 35 min"
                                Click="ChipDaily_Click"/>
                </StackPanel>

                <DockPanel>
                  <TextBlock x:Name="IntervalLabel"
                             DockPanel.Dock="Right"
                             Width="64"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"/>
                  <Slider x:Name="IntervalSlider"
                          Minimum="1"
                          Maximum="120"
                          TickFrequency="1"
                          IsSnapToTickEnabled="True"
                          ValueChanged="Interval_Changed"/>
                </DockPanel>

                <TextBlock Text="Use 1 minute while testing. Switch to 30–45 minutes for daily use."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <!-- Circular reveal -->
            <Border Background="{StaticResource CardBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Circular reveal"
                           FontWeight="SemiBold"
                           FontSize="13.5"
                           Margin="0,0,0,10"/>
                <DockPanel>
                  <TextBlock x:Name="DurationLabel"
                             DockPanel.Dock="Right"
                             Width="64"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"/>
                  <Slider x:Name="DurationSlider"
                          Minimum="250"
                          Maximum="2000"
                          TickFrequency="50"
                          IsSnapToTickEnabled="True"
                          ValueChanged="Duration_Changed"/>
                </DockPanel>
                <TextBlock Text="The iris wipe is locked to 60 fps and expands from the center of each monitor."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <!-- Options -->
            <Border Background="{StaticResource CardBrush}"
                    CornerRadius="10"
                    Padding="16">
              <StackPanel>
                <CheckBox x:Name="FullscreenBox"
                          Style="{StaticResource ToggleSwitch}"
                          Content="Pause while a fullscreen game, video, or presentation is running"
                          Margin="0,0,0,14"/>
                <CheckBox x:Name="ShuffleBox"
                          Style="{StaticResource ToggleSwitch}"
                          Content="Shuffle wallpapers (never repeats the current image)"
                          Margin="0,0,0,14"/>
                <CheckBox x:Name="StartupBox"
                          Style="{StaticResource ToggleSwitch}"
                          Content="Start with Windows"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </DockPanel>
  </Border>
</Window>
