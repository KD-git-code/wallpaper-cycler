<Window x:Class="WallpaperCycle.Views.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WallpaperCycle"
        Height="620" Width="560"
        MinHeight="560" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"
               Text="WallpaperCycle"/>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}"
               TextWrapping="Wrap" Margin="0,0,0,16" Text="Starting…"/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="ChangeNowButton" Content="Change now" Margin="0,0,8,0" Click="ChangeNow_Click"/>
      <Button x:Name="SaveButton" Content="Save settings" Click="Save_Click"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Wallpaper folder" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Click="Browse_Click"/>
              <TextBox x:Name="FolderBox"/>
            </DockPanel>
            <TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Change interval" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Button Content="Testing · 1 min" Margin="0,0,8,0" Click="PresetTest_Click"/>
              <Button Content="Production · 35 min" Click="PresetProd_Click"/>
            </StackPanel>
            <DockPanel>
              <TextBlock x:Name="IntervalLabel" DockPanel.Dock="Right" Width="72" TextAlignment="Right" VerticalAlignment="Center"/>
              <Slider x:Name="IntervalSlider" Minimum="1" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True"
                      ValueChanged="Interval_Changed"/>
            </DockPanel>
            <TextBlock Text="Use 1 minute while testing. Switch to 30–45 minutes for daily use."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Circular reveal" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <DockPanel>
              <TextBlock x:Name="DurationLabel" DockPanel.Dock="Right" Width="72" TextAlignment="Right" VerticalAlignment="Center"/>
              <Slider x:Name="DurationSlider" Minimum="250" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True"
                      ValueChanged="Duration_Changed"/>
            </DockPanel>
            <TextBlock Text="The iris wipe is locked to 60 fps and expands from the center of each monitor."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16">
          <StackPanel>
            <CheckBox x:Name="FullscreenBox" Content="Pause while a fullscreen game, video, or presentation is running" Margin="0,0,0,10"/>
            <CheckBox x:Name="ShuffleBox" Content="Shuffle wallpapers (never repeats the current image)" Margin="0,0,0,10"/>
            <CheckBox x:Name="StartupBox" Content="Start with Windows"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
