<Window x:Class="WallpaperCycle.Views.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WallpaperCycle"
        Height="640"
        Width="560"
        MinHeight="520"
        MinWidth="460"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="-1"
                        CornerRadius="12"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <!-- Outer rounded surface -->
  <Border x:Name="RootBorder"
          Background="{StaticResource BgBrush}"
          BorderBrush="#FF383838"
          BorderThickness="1"
          CornerRadius="12"
          ClipToBounds="True">
    <DockPanel>

      <!-- ══════════ Custom title bar (drag region) ══════════ -->
      <Border x:Name="TitleBar"
              DockPanel.Dock="Top"
              Height="36"
              Background="{StaticResource BgBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- App mark + title — also part of drag area -->
          <StackPanel Orientation="Horizontal"
                      VerticalAlignment="Center"
                      Margin="14,0,0,0"
                      IsHitTestVisible="False">
            <Ellipse Width="10"
                     Height="10"
                     Fill="{StaticResource AccentBrush}"
                     Margin="0,0,8,0"/>
            <TextBlock Text="WallpaperCycle"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>

          <!-- Caption buttons — must be hit-testable in chrome -->
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal">

            <!-- Minimize -->
            <Button Style="{StaticResource CaptionButton}"
                    Content="–"
                    FontSize="16"
                    Click="Minimize_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <Button.ToolTip>
                <ToolTip Foreground="Black"
                         Background="White">
                  <TextBlock Text="Minimize"
                             Foreground="Black"/>
                </ToolTip>
              </Button.ToolTip>
            </Button>

            <!-- Close -->
            <Button Style="{StaticResource CaptionCloseButton}"
                    Content="✕"
                    FontSize="12"
                    Click="Close_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <Button.ToolTip>
                <ToolTip Foreground="Black"
                         Background="White">
                  <TextBlock Text="Close"
                             Foreground="Black"/>
                </ToolTip>
              </Button.ToolTip>
            </Button>

          </StackPanel>
        </Grid>
      </Border>

      <!-- Thin accent line -->
      <Border DockPanel.Dock="Top"
              Height="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0"
                               EndPoint="1,0">
            <GradientStop Color="#0060CDFF"
                          Offset="0"/>
            <GradientStop Color="#FF60CDFF"
                          Offset="0.35"/>
            <GradientStop Color="#FF60CDFF"
                          Offset="0.65"/>
            <GradientStop Color="#0060CDFF"
                          Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <!-- ══════════ Main content ══════════ -->
      <DockPanel Margin="20,16,20,16">

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top"
                    Margin="0,0,0,16">
          <TextBlock Text="WallpaperCycle"
                     FontSize="24"
                     FontWeight="SemiBold"
                     Margin="0,0,0,4"/>
          <TextBlock x:Name="StatusText"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="12.5"
                     TextWrapping="Wrap"
                     Text="Starting…"/>
        </StackPanel>

        <!-- Footer -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
          <Button x:Name="ChangeNowButton"
                  Content="Change now"
                  Margin="0,0,8,0"
                  Click="ChangeNow_Click"/>
          <Button x:Name="SaveButton"
                  Content="Save settings"
                  Style="{StaticResource AccentButton}"
                  Click="Save_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>

            <!-- Wallpaper folder -->
            <Border Background="{StaticResource CardBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Wallpaper folder"
                           FontWeight="SemiBold"
                           FontSize="13.5"
                           Margin="0,0,0,10"/>

                <DockPanel Margin="0,0,0,10">
                  <Button DockPanel.Dock="Right"
                          Style="{StaticResource IconButton}"
                          Margin="8,0,0,0"
                          Click="Browse_Click"
                          Content="Browse">
                    <Button.ToolTip>
                      <ToolTip
                        Foreground="Black"
                        Background="White">
                        <TextBlock
                          Text="Browse for folder"
                          Foreground="Black"/>
                      </ToolTip>
                    </Button.ToolTip>
                  </Button>
                  <TextBox x:Name="FolderBox"
                           Style="{StaticResource PathBoxStyle}"/>
                </DockPanel>

                <DockPanel>
                  <Button x:Name="RefreshButton"
                          DockPanel.Dock="Right"
                          Style="{StaticResource IconButton}"
                          Padding="8,4"
                          Click="Refresh_Click"
                          Content="↻"
                          FontSize="14">
                    <Button.ToolTip>
                      <ToolTip
                        Foreground="Black"
                        Background="White">
                        <TextBlock
                          Text="Refresh folder"
                          Foreground="Black"/>
                      </ToolTip>
                    </Button.ToolTip>
                  </Button>
                  <TextBlock x:Name="CountText"
                             Foreground="{StaticResource MutedBrush}"
                             FontSize="12.5"
                             VerticalAlignment="Center"
                             Text="0 image(s) found"/>
                </DockPanel>

                <!-- Empty state -->
                <Border x:Name="EmptyStatePanel"
                        Visibility="Collapsed"
                        Margin="0,14,0,0"
                        Padding="16"
                        Background="#18FFFFFF"
                        CornerRadius="8">
                  <StackPanel HorizontalAlignment="Center">
                    <Viewbox Width="56"
                             Height="56"
                             Margin="0,0,0,10">
                      <Canvas Width="64"
                              Height="64">
                        <Rectangle Width="48"
                                   Height="36"
                                   Canvas.Left="8"
                                   Canvas.Top="16"
                                   RadiusX="4"
                                   RadiusY="4"
                                   Stroke="#FF60CDFF"
                                   StrokeThickness="2"
                                   Fill="#1860CDFF"/>
                        <Ellipse Width="14"
                                 Height="14"
                                 Canvas.Left="14"
                                 Canvas.Top="22"
                                 Fill="#FF60CDFF"
                                 Opacity="0.5"/>
                        <Path Stroke="#FF60CDFF"
                              StrokeThickness="2"
                              Data="M 12,44 L 28,30 L 38,38 L 52,24"/>
                      </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="EmptyStateTitle"
                               Text="No images found"
                               FontWeight="SemiBold"
                               FontSize="13.5"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="EmptyStateMessage"
                               Text="Add JPG, PNG, or WebP files to this folder, or choose a different location."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="360"/>
                    <Button Content="Choose folder"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0"
                            Padding="16,7"
                            Click="Browse_Click"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- Change interval -->
            <Border Background="{StaticResource CardBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Change interval"
                           FontWeight="SemiBold"
                           FontSize="13.5"
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">
                  <ToggleButton x:Name="ChipTest"
                                Style="{StaticResource ChipStyle}"
                                Content="Testing · 1 min"
                                Margin="0,0,8,0"
                                Click="ChipTest_Click"/>
                  <ToggleButton x:Name="ChipDaily"
                                Style="{StaticResource ChipStyle}"
                                Content="Daily · 35 min"
                                Click="ChipDaily_Click"/>
                </StackPanel>

                <DockPanel>
                  <TextBlock x:Name="IntervalLabel"
                             DockPanel.Dock="Right"
                             Width="64"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"/>
                  <Slider x:Name="IntervalSlider"
                          Minimum="1"
                          Maximum="120"
                          TickFrequency="1"
                          IsSnapToTickEnabled="True"
                          ValueChanged="Interval_Changed"/>
                </DockPanel>

                <TextBlock Text="Use 1 minute while testing. Switch to 30–45 minutes for daily use."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <!-- Circular reveal -->
            <Border Background="{StaticResource CardBrush}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Circular reveal"
                           FontWeight="SemiBold"
                           FontSize="13.5"
                           Margin="0,0,0,10"/>
                <DockPanel>
                  <TextBlock x:Name="DurationLabel"
                             DockPanel.Dock="Right"
                             Width="64"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"/>
                  <Slider x:Name="DurationSlider"
                          Minimum="250"
                          Maximum="2000"
                          TickFrequency="50"
                          IsSnapToTickEnabled="True"
                          ValueChanged="Duration_Changed"/>
                </DockPanel>
                <TextBlock Text="The iris wipe is locked to 60 fps and expands from the center of each monitor."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <!-- Options -->
            <Border Background="{StaticResource CardBrush}"
                    CornerRadius="10"
                    Padding="16">
              <StackPanel>
                <CheckBox x:Name="FullscreenBox"
                          Style="{StaticResource ToggleSwitch}"
                          Content="Pause while a fullscreen game, video, or presentation is running"
                          Margin="0,0,0,14"/>
                <CheckBox x:Name="ShuffleBox"
                          Style="{StaticResource ToggleSwitch}"
                          Content="Shuffle wallpapers (never repeats the current image)"
                          Margin="0,0,0,14"/>
                <CheckBox x:Name="StartupBox"
                          Style="{StaticResource ToggleSwitch}"
                          Content="Start with Windows"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </DockPanel>
  </Border>
</Window>
